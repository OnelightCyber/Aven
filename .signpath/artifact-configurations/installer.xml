<?xml version="1.0" encoding="utf-8"?>
<!-- The installer, built around the already signed browser: the setup alone
     in a zip. Paste into SignPath as the "installer" artifact configuration. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Aven-Windows-x64-setup.exe" product-name="Aven" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
