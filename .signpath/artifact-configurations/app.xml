<?xml version="1.0" encoding="utf-8"?>
<!-- The browser itself, as the release workflow uploads it: aven-desktop.exe
     alone in a zip. Paste into SignPath as the "app" artifact configuration. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="aven-desktop.exe" product-name="Aven" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
